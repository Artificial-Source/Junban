  "components": {
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "due_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": ["object", "null"],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MutationResponse": {
        "type": "object",
        "required": ["event"],
        "properties": {
          "event": {
            "$ref": "#/components/schemas/TaskEventDto"
          },
          "task": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TaskDto"
              }
            ]
          }
        }
      },
      "ReplaceTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "due_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TaskDto": {
        "type": "object",
        "required": ["id", "title", "status", "created_at", "updated_at", "revision"],
        "properties": {
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "due_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatusDto"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskEventDto": {
        "type": "object",
        "required": ["revision", "operation_id", "event_type", "task_id", "occurred_at"],
        "properties": {
          "event_type": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "task": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TaskDto"
              }
            ]
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "required": ["tasks", "revision"],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskDto"
            }
          }
        }
      },
      "TaskStatusDto": {
        "type": "string",
        "enum": ["pending", "completed"]
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
