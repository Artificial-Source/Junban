// TEMPORARY / NON-PUBLIC — Phase 7 Wave 0 host-placement spike only.
// This is NOT package junban:plugin@0.1.0 and must not be treated as a product ABI.
// Remove when evidence no longer needs the source component world.

package junban:spike@0.0.0;

world spike {
    /// Echo/add identity used for first-call and warm-call timing.
    export ping: func(input: u32) -> u32;

    /// Deliberate guest trap (unreachable). Host must survive.
    export force-trap: func();

    /// Tight guest CPU loop. Host must interrupt via epoch deadline.
    export cpu-loop: func();

    /// Grow guest-owned buffers by approximately `pages` * 64 KiB.
    /// Returns the approximate resident guest buffer bytes after growth, or an error string.
    export grow-memory: func(pages: u32) -> result<u32, string>;
}
