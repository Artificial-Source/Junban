          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": ["integer", "null"],
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revisioned task event stream",
            "content": {
              "text/event-stream": {}
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
