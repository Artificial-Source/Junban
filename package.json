{
  "name": "junban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:local-voice-acceptance": "node scripts/run-phase6-local-voice-acceptance.mjs",
    "audit:dependencies": "pnpm audit --audit-level high",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:runtime-boundary": "node scripts/check-runtime-boundary.mjs",
    "check:local-voice-assets": "node scripts/check-local-voice-assets.mjs --require-dist",
    "check:phase6-legacy-visual": "node scripts/check-phase6-legacy-visual-baseline.mjs",
    "check:phase7-legacy-visual": "node scripts/check-phase7-legacy-visual-baseline.mjs",
    "check:phase7-legacy-visual:self-check": "node scripts/check-phase7-legacy-visual-baseline.mjs --self-check",
    "check:phase7-plugin-artifacts": "python3 scripts/check-phase7-plugin-artifacts.py",
    "check:phase7-plugin-artifacts:bootstrap": "python3 scripts/check-phase7-plugin-artifacts.py --bootstrap-empty",
    "dogfood:phase7-plugins": "python3 scripts/run-phase7-plugin-dogfood.py",
    "bench:phase7-wave5": "python3 scripts/check-phase7-wave5-performance.py --collect --authoritative --build-base",
    "bench:phase7-wave5:quick": "python3 scripts/check-phase7-wave5-performance.py --collect --quick --non-authoritative --build-base",
    "bench:phase7-wave5:self-check": "python3 scripts/check-phase7-wave5-performance.py --self-check",
    "check:phase7-wave5-evidence": "python3 scripts/check-phase7-wave5-performance.py --check-evidence",
    "check:phase7-wave5-preliminary-evidence": "python3 scripts/check-phase7-wave5-performance.py --check-preliminary-evidence",
    "check:phase7-reference-matrix": "python3 scripts/check-phase7-reference-matrix.py",
    "check:phase7-reference-matrix:self-check": "python3 scripts/check-phase7-reference-matrix.py --self-check",
    "check:phase7-slice2e": "python3 scripts/check-phase7-slice2e.py",
    "bench:hosted-server": "python3 scripts/bench-hosted-server.py",
    "bench:hosted-server:quick": "python3 scripts/bench-hosted-server.py --quick",
    "bench:scale": "python3 scripts/bench-hosted-server.py --mode scale",
    "bench:scale:quick": "python3 scripts/bench-hosted-server.py --mode scale --quick",
    "bench:temporal": "python3 scripts/bench-hosted-server.py --mode temporal",
    "bench:temporal:quick": "python3 scripts/bench-hosted-server.py --mode temporal --quick",
    "bench:phase4": "python3 scripts/bench-hosted-server.py --mode phase4",
    "bench:phase4:quick": "python3 scripts/bench-hosted-server.py --mode phase4 --quick",
    "bench:phase5": "python3 scripts/check-phase5-automation-budget.py",
    "bench:phase5:quick": "python3 scripts/check-phase5-automation-budget.py --quick",
    "bench:phase6-disabled-matched": "python3 scripts/check-phase6-disabled-matched-release.py",
    "bench:phase6-disabled-matched:quick": "python3 scripts/check-phase6-disabled-matched-release.py --quick",
    "bench:phase6-disabled-matched:self-check": "python3 scripts/check-phase6-disabled-matched-release.py --self-check",
    "conformance:phase5": "python3 scripts/check-phase5-conformance.py --authoritative",
    "conformance:phase6": "python3 scripts/check-phase5-conformance.py --phase6 --authoritative",
    "bench:phase6-enabled:self-check": "python3 scripts/check-phase6-enabled-benchmark.py --self-check",
    "bench:self-check": "python3 scripts/bench-hosted-server.py --self-check && python3 scripts/check-phase6-disabled-matched-release.py --self-check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm contract:check && pnpm check:docs && pnpm check:runtime-boundary && pnpm check:local-voice-assets && pnpm check:phase6-legacy-visual && pnpm check:phase7-legacy-visual && pnpm check:phase7-plugin-artifacts && pnpm check:phase7-slice2e"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@huggingface/transformers": "4.3.2",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@ricky0123/vad-web": "0.0.31",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
