{
  "name": "junban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "audit:dependencies": "pnpm audit --audit-level high",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:runtime-boundary": "node scripts/check-runtime-boundary.mjs",
    "bench:hosted-server": "python3 scripts/bench-hosted-server.py",
    "bench:hosted-server:quick": "python3 scripts/bench-hosted-server.py --quick",
    "bench:scale": "python3 scripts/bench-hosted-server.py --mode scale",
    "bench:scale:quick": "python3 scripts/bench-hosted-server.py --mode scale --quick",
    "bench:temporal": "python3 scripts/bench-hosted-server.py --mode temporal",
    "bench:temporal:quick": "python3 scripts/bench-hosted-server.py --mode temporal --quick",
    "bench:self-check": "python3 scripts/bench-hosted-server.py --self-check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm contract:check && pnpm check:docs && pnpm check:runtime-boundary"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "js-yaml": "4.3.0"
    }
  }
}
